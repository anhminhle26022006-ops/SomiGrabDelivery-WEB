# Safe template only. Copy to .env and fill in local values.
# Server/process environment overrides .env.
SEPAY_ENVIRONMENT="sandbox"
SEPAY_MERCHANT_ID=""
SEPAY_SECRET_KEY=""
SEPAY_IPN_SECRET=""
SOMI_PUBLIC_URL=""
SOMI_APP_URL=""
SOMI_DB_HOST=""
SOMI_DB_PORT="5432"
SOMI_DB_NAME=""
SOMI_DB_USER=""
SOMI_DB_PASSWORD=""
SOMI_DB_SSLMODE="require"
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
SOMI_IDENTITY_ENCRYPTION_KEY=""
SOMI_MESSAGE_ENCRYPTION_KEY=""
# free = non-commercial, no key; commercial = paid customer endpoint with key.
OPEN_METEO_MODE="free"
OPEN_METEO_API_KEY=""
SOMI_PHONE_OTP_MODE=""

# Render/worker performance settings (process environment takes precedence).
SOMI_DB_PERSISTENT="0"
# Set to 1 for a transaction pooler that ignores startup search_path options.
SOMI_DB_SET_SEARCH_PATH="0"
SOMI_MAX_WORKERS="6"

# Geoapify backend key: autocomplete, geocoding and motorcycle routing.
GEOAPIFY_API_KEY=""
# Separate browser key for Leaflet raster tiles; restrict allowed referrers/origins.
GEOAPIFY_BROWSER_API_KEY=""
# Người 3: manual payout reserves PROCESSING; Admin reconciles a completed bank transfer.
SOMI_PAYOUT_MODE=manual
# Server-side Supabase Storage (private bucket; never use publishable/anon keys).
# Legacy alias; SOMI_STORAGE_DRIVER below takes precedence.
# SOMI_STORAGE_PROVIDER=supabase
# Legacy filesystem backend only: dedicated private directory outside the web root.
SOMI_STORAGE_ROOT=
# Random secret >=32 characters, supplied through hosting Secrets.
SOMI_STORAGE_SIGNING_KEY=
# Enable only for a dedicated SOMI bucket/directory; removes unreferenced random objects older than 24 hours.
SOMI_STORAGE_PRUNE_ORPHANS=0
# Use supabase on Render; local retains compatibility with the private filesystem adapter.
SOMI_STORAGE_DRIVER=local
SUPABASE_URL=""
# Server only: supply either the new secret key or the legacy service_role JWT.
SUPABASE_SECRET_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET=somi-private
# Optional Docker lifecycle: run shared email + Person 3 workers in the web container.
SOMI_RUN_WORKERS=0
# Apply versioned migrations before starting web traffic. Enable explicitly on hosting.
SOMI_MIGRATE_ON_START=0
