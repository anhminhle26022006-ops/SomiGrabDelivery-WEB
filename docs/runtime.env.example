# Environment reference only. PHP does NOT load this file automatically.
# Configure these in the server/process environment. Never commit real values.
SOMI_DB_HOST=
SOMI_DB_PORT=5432
SOMI_DB_NAME=
SOMI_DB_USER=
SOMI_DB_PASSWORD=
SOMI_DB_SSLMODE=require
SOMI_APP_URL=https://your-application.example

# Direct provider: enable Routes API and Geocoding API for this Google key.
# Open-Meteo uses the commercial customer endpoint; never expose keys to browser.
GOOGLE_MAPS_API_KEY=
OPEN_METEO_API_KEY=
# Service area is Ho Chi Minh City, verified by reverse geocoding both points.
# Optional alternative: trusted internal adapter implementing the same checks.
# SOMI_PRICING_CONTEXT_URL=https://your-adapter.example/context
# SOMI_PRICING_CONTEXT_TOKEN=

# Existing auth services; configure separately when exercising these flows.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# SOMI_PHONE_OTP_MODE=demo   # Explicit local demo only; no real SMS provider.
