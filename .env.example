# Documentation only: this PHP app reads process environment, not .env files.
# Windows: set User variables, then run scripts/serve.ps1; never commit secrets.
SOMI_DB_HOST=
SOMI_DB_PORT=5432
SOMI_DB_NAME=postgres
SOMI_DB_USER=
SOMI_DB_PASSWORD=
SOMI_DB_SSLMODE=require
SOMI_APP_URL=http://127.0.0.1:3000
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SOMI_IDENTITY_ENCRYPTION_KEY=
# Phone verification has no real SMS provider yet. Explicit test/demo only:
SOMI_PHONE_OTP_MODE=
