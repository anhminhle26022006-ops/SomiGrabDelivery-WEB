# Reference only: PHP loads root .env, not this documentation file.
# Set server/process variables or fill root .env locally. Never commit real values.
# Scope 2026-11-06: Person 1 owns DB/auth/payment/refund/email;
# Person 2 owns delivery/GPS; Person 3 owns Google/address integration.
# See BACKEND-SCOPE.md and PERSON1-API.md.
SOMI_DB_HOST=
SOMI_DB_PORT=5432
SOMI_DB_NAME=
SOMI_DB_USER=
SOMI_DB_PASSWORD=
SOMI_DB_SSLMODE=require
SOMI_APP_URL=https://your-application.example

# Person 3: enable Routes API and Geocoding API for this server-side Google key.
# Places/Autocomplete is next work; its frontend/server key policy is not implemented here.
# Open-Meteo uses the commercial customer endpoint; never expose keys to browser.
GOOGLE_MAPS_API_KEY=
# Open-Meteo transport/key ownership still needs team confirmation (not a Google API).
OPEN_METEO_API_KEY=
# Service area is Ho Chi Minh City, verified by reverse geocoding both points.
# Optional alternative: trusted internal adapter implementing the same checks.
# SOMI_PRICING_CONTEXT_URL=https://your-adapter.example/context
# SOMI_PRICING_CONTEXT_TOKEN=

# Person 1: existing auth/email services; configure for the corresponding flows.
# SePay Gateway is selected. Merchant signing key and IPN key are different.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# SOMI_PHONE_OTP_MODE=demo   # Explicit local demo only; no real SMS provider.

# Person 1: signed SePay Gateway checkout and authenticated IPN/reconciliation.
# Setup: SEPAY-SETUP.md. Validate without printing keys: php bin/sepay-check.php
# Use a public HTTPS base URL including a deployment subdirectory, if any.
SOMI_PUBLIC_URL=https://your-application.example
SEPAY_ENVIRONMENT=sandbox
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
# Configure IPN auth type SECRET_KEY in SePay; choose an independent >=32-char secret.
# IPN URL: <SOMI_PUBLIC_URL>/public/api/payments/callback.php
SEPAY_IPN_SECRET=
# USD payment is disabled; no automatic conversion or FX policy.
# SePay Gateway refunds require original-method operator processing plus evidence reconciliation.

# Base64 of 32 random bytes; keep stable to decrypt queued email across worker restarts.
# Existing SOMI_IDENTITY_ENCRYPTION_KEY is a fallback, not a required second copy.
SOMI_MESSAGE_ENCRYPTION_KEY=
# Required by existing identity vault; never commit actual values.
SOMI_IDENTITY_ENCRYPTION_KEY=
# Optional future SMS adapter only; no vendor is chosen or silently enabled.
# SOMI_SMS_BRIDGE_URL=https://your-trusted-sms-adapter.example
# SOMI_SMS_BRIDGE_TOKEN=
# Legacy manual-bank records only (new payments use SePay).
# SOMI_BANK_NAME=
# SOMI_BANK_ACCOUNT=
# SOMI_BANK_ACCOUNT_NAME=
